{
  "manifest_version": 3,
  "name": "Aspen — contexto comercial",
  "version": "0.2.0",
  "description": "Mostra contexto comercial do Aspen na conversa atual do WhatsApp Web.",
  "permissions": [],
  "host_permissions": ["https://app.aspenestamparia.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["config.js", "provider.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Contexto comercial Aspen"
  }
}
