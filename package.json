{
  "name": "aspen-dashboard",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite-dev.mjs",
    "dev:vercel": "vercel dev",
    "build:api": "tsc -p api/tsconfig.api.json",
    "clean:web": "rm -f public/assets/index-*.js public/assets/index-*.css public/assets/index-*.js.map public/assets/index-*.css.map",
    "build:web": "npm run clean:web && vite build",
    "build": "npm run build:api && npm run build:web",
    "dev:api": "tsc -p api/tsconfig.api.json --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check:db-migrations": "node scripts/check-db-migrations.mjs",
    "db:migration:preflight": "node scripts/migration-preflight.mjs",
    "preview": "vite preview",
    "server": "vercel dev",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc -p api/tsconfig.api.json --noEmit",
    "typecheck": "npm run type-check",
    "check:tailwind": "node scripts/check-tailwind-content.mjs",
    "check:db-boundary": "node scripts/check-postgres-boundary.mjs",
    "check": "npm run lint && npm run type-check && npm run check:tailwind && npm run build",
    "verify:fast": "npm run lint && npm run typecheck && npm run check:db-boundary && npm run check:db-migrations && npm run test:unit",
    "verify:full": "npm run verify:fast && npm run build:web && npm run test:e2e",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit:run": "TZ=UTC node --test tests/unit/*.test.{js,ts}",
    "test:unit": "npm run build:api && npm run test:unit:run",
    "test:e2e": "npx playwright test",
    "test:e2e:smoke": "npm run build:api && npx playwright test --grep \"@smoke\"",
    "test:e2e:staging": "DOTENV_CONFIG_PATH=$HOME/.config/aspen-dashboard/.env.local STAGING_E2E=1 npx playwright test tests/postgres-only-cutover.spec.js tests/quotation-cutover-staging.spec.js",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "test:whatsapp": "node scripts/test-whatsapp-sequence.mjs",
    "test:whatsapp-flows": "node scripts/test-whatsapp-flows.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/kv": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "handlebars": "^4.7.9",
    "lucide-react": "^0.468.0",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.59.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "yarn": "^1.22.22"
  }
}
