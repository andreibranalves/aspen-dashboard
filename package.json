{
  "name": "aspen-dashboard",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/vite-dev.mjs",
    "dev:vercel": "vercel dev",
    "build:api": "node scripts/build-api.mjs",
    "clean:web": "rm -f public/assets/index-*.js public/assets/index-*.css public/assets/index-*.js.map public/assets/index-*.css.map",
    "build:web": "npm run clean:web && vite build",
    "build": "npm run build:api && npm run build:web",
    "dev:api": "tsc -p api/tsconfig.api.json --watch",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:operational": "drizzle-kit migrate --config=scripts/drizzle.staging.config.ts",
    "migrate:apply": "node scripts/apply-migrations.mjs",
    "check:db-migrations": "node scripts/check-db-migrations.mjs",
    "db:migration:preflight": "node scripts/migration-preflight.mjs",
    "verify:quotation-company": "npm run build:api && node scripts/verify-quotation-company-backfill.mjs",
    "preview:preflight": "node scripts/preview-preflight.mjs",
    "db:backup": "node scripts/backup-crm.mjs",
    "leads:reconcile": "npm run build:api --silent && node scripts/leads-reconcile.mjs",
    "quotation-origin:candidates": "npm run build:api --silent && node scripts/quotation-origin-candidates.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck:api": "tsc -p api/tsconfig.api.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "check:db-boundary": "node scripts/check-postgres-boundary.mjs",
    "check:integration-boundary": "node scripts/check-external-integration-boundary.mjs",
    "check:whatsapp-extension": "node scripts/check-whatsapp-extension.mjs",
    "check:vercel-functions": "node scripts/check-vercel-function-layout.mjs",
    "check:ui-ratchet": "node scripts/check-ui-ratchet.mjs",
    "verify:fast": "npm run lint && npm run typecheck && npm run check:db-boundary && npm run check:integration-boundary && npm run check:whatsapp-extension && npm run check:db-migrations && npm run check:vercel-functions && npm run check:ui-ratchet",
    "verify:full": "node scripts/lib/local-e2e-env.mjs && npm run verify:fast && env -u TEST_DATABASE_URL -u DATABASE_URL npm run test:unit && npm run test:postgres && npm run build:web && npm run test:e2e && npm run test:e2e:safe",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit:run": "TZ=UTC node --test --test-concurrency=4 tests/unit/*.test.{js,ts}",
    "test:unit": "npm run build:api && npm run test:unit:run",
    "test:unit:focused": "npm run build:api && TZ=UTC node --test",
    "test:postgres": "npm run build:api && node scripts/test-postgres.mjs",
    "ads:offline": "npm run build:api --silent && node scripts/ads-offline.mjs",
    "test:postgres:docker": "node scripts/test-postgres-docker.mjs",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down --volumes --remove-orphans",
    "test:e2e": "npx playwright test",
    "test:visual": "npx playwright test -c playwright.visual.config.js",
    "test:visual:update": "npx playwright test -c playwright.visual.config.js --update-snapshots",
    "test:e2e:smoke": "npm run build:api && npx playwright test --grep \"@smoke\"",
    "test:e2e:safe": "npm run build:api && node scripts/run-safe-e2e.mjs",
    "test:e2e:preview": "node scripts/run-preview-e2e.mjs",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "whatsapp:readiness": "node scripts/whatsapp-delivery-readiness.mjs"
  },
  "dependencies": {
    "@lexical/html": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@sentry/node": "^11.0.0",
    "@sentry/react": "^11.0.0",
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/kv": "^3.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "handlebars": "^4.7.9",
    "lexical": "^0.49.0",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^0.468.0",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.1.0",
    "radix-ui": "1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^6.9.2",
    "sanitize-html": "2.17.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
